# Navigation (setzt eza voraus)
alias ls="eza"
alias ll="eza --icons -l"
alias la="eza --icons -la"
alias lt="eza --tree"

# Editoren & Data Tools
alias v="nvim"
alias vi="nvim"
alias vd="visidata"

# Python / UV Shortcuts
alias py="python"

# Bequemlichkeit
alias c="clear"
alias ..="cd .."
alias ...="cd ../.."
alias ....="cd ../../.."
